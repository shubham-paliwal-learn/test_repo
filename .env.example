# Copy to .env (or export in the shell) and adjust for your machine.
TMA_SECRET_KEY=change-me-in-production
TMA_JWT_SECRET=another-long-random-string
TMA_DATABASE=sqlite:///instance/tma.db

# Redis cache + Celery broker
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Bootstrap admin (created programmatically - no registration allowed)
TMA_ADMIN_USERNAME=admin
TMA_ADMIN_PASSWORD=Admin@12345
TMA_ADMIN_EMAIL=admin@trekking.local

# Scheduled jobs
REMINDER_HOUR=7
REPORT_HOUR=8
CELERY_TIMEZONE=Asia/Kolkata

# Delivery channels (leave blank to log into logs/outbox.log instead)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=tma-noreply@trekking.local
GCHAT_WEBHOOK_URL=
SMS_GATEWAY_URL=
